{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs24",
      "ignore": ["node_modules", "src", "build.mjs", "tsconfig.json", ".gitignore", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9189
    },
    "firestore": {
      "port": 8180,
      "websocketPort": 9250
    },
    "storage": {
      "port": 9289
    },
    "functions": {
      "port": 5101
    },
    "ui": {
      "enabled": false
    },
    "hub": {
      "port": 4410
    },
    "logging": {
      "port": 4510
    },
    "eventarc": {
      "port": 9389
    },
    "tasks": {
      "port": 9489
    }
  }
}
