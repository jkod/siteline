{
  "$schema": "../../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/push-sw.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**", "/*.woff2", "/*.woff"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "translations",
      "urls": ["/i18n/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 4, "maxAge": "7d", "timeout": "3s" }
    }
  ]
}
